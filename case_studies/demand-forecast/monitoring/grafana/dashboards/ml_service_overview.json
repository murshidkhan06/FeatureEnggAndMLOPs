{
 "title": "ML Service Overview",
 "uid": "ml-service-overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "API availability (up)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "up{job=\"ml-api\"}",
     "legendFormat": "up",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Request rate (req/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "sum(rate(api_requests_total{endpoint=\"/predict\"}[1m]))",
     "legendFormat": "req/s",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Error ratio (5xx / all)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "sum(rate(api_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(api_requests_total[5m])),1e-9)",
     "legendFormat": "error ratio",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Model version",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "model_info",
     "legendFormat": "{{version}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Latency p50 / p95 (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_latency_seconds_bucket{endpoint=\"/predict\"}[1m])))",
     "legendFormat": "p95",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.50, sum by (le) (rate(api_request_latency_seconds_bucket{endpoint=\"/predict\"}[1m])))",
     "legendFormat": "p50",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Predictions by demand band (per min)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (risk_level) (rate(model_predictions_total[1m])) * 60",
     "legendFormat": "{{risk_level}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Requests by status",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(api_requests_total{endpoint=\"/predict\"}[1m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Mean predicted units per request",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "rate(model_score_sum[5m]) / clamp_min(rate(model_score_count[5m]),1e-9)",
     "legendFormat": "mean score",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Drift: KS statistic D per feature",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "drift_ks_statistic",
     "legendFormat": "{{feature}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Drift flag (1 = significant AND large)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "drift_flag",
     "legendFormat": "{{feature}}",
     "refId": "A"
    }
   ]
  }
 ],
 "tags": [
  "mlops"
 ],
 "editable": true
}