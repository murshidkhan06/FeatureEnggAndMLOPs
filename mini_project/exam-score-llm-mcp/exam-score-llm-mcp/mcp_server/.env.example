# mcp_server/.env.example  ->  copy to mcp_server/.env  (the real .env is git-ignored)
# Nothing here is a secret. The MCP server only needs to know where the ML API lives.

# The ONE address this server may call. Running everything on your laptop: localhost.
# (Inside Docker Compose this is set to http://ml-api:8000 for you.)
ML_API_BASE_URL=http://localhost:8000
ML_API_TIMEOUT_SECONDS=10

# streamable-http = normal use (the orchestrator connects over HTTP).  stdio = for the MCP Inspector.
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8001
# Host headers accepted (DNS-rebinding protection). Add names other containers use to reach us.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mcp-server:*

LOG_LEVEL=INFO
