# orchestrator/.env.example  ->  copy to orchestrator/.env  (the real .env is git-ignored)
# Used when you run the orchestrator directly (not with Docker Compose).

# ---- Choose ONE language-model provider -------------------------------------------------
# groq | ollama   (switching is just this line)
LLM_PROVIDER=groq
LLM_TIMEOUT_SECONDS=60

# ---- Groq (cloud) ------------------------------------------------------------------------
# Create a key at https://console.groq.com . NEVER commit it, paste it in chat, or put it in the frontend.
GROQ_API_KEY=
# Pick a model that supports tool calling from the Groq console's model list.
# Example (verify it is still available): llama-3.3-70b-versatile
GROQ_MODEL=

# ---- Ollama (local) ----------------------------------------------------------------------
# Run `ollama serve` and `ollama pull <model>` first. The model MUST support tool calling.
# Examples (verify in the Ollama library): llama3.1:8b, qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ---- Other services ----------------------------------------------------------------------
MCP_SERVER_URL=http://localhost:8001/mcp
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Safety limits (defaults are fine) ---------------------------------------------------
MAX_TOOL_ROUNDS=3
MAX_PREDICTIONS_PER_TURN=4
STRICT_PROVENANCE=true
LOG_LEVEL=INFO
