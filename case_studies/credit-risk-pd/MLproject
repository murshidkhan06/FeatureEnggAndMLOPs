name: credit-risk-pd
python_env: python_env.yaml
entry_points:
  train:
    parameters: {version: {type: string, default: v1}}
    command: "python -m src.models.train --version {version}"
  batch_score:
    parameters: {as_of: {type: string, default: "2025-06-30"}}
    command: "python -m src.models.batch_score --as-of {as_of}"
  drift:
    parameters:
      prod: {type: string, default: data/production/batch_drifted.csv}
      today: {type: string, default: "2025-06-30"}
    command: "python -m src.monitoring.run_drift_check --prod {prod} --today {today}"
  retrain:
    parameters:
      prod: {type: string, default: data/production/batch_drifted.csv}
      window: {type: string, default: rolling}
    command: "python -m src.models.retrain --prod {prod} --window {window}"
