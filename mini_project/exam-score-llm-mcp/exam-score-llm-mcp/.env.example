# .env.example  ->  copy to .env  (git-ignored).  Read automatically by `docker compose`.
# This is the ONLY file you edit for the Docker Compose setup.

# Path to the EXISTING ML project (the one with its own Dockerfile and models/ folder).
# It is built as the `ml-api` service. Not copied into this repo.
ML_API_DIR=../exam-score-mlops

# ---- Which LLM? --------------------------------------------------------------------------
# groq | ollama
LLM_PROVIDER=groq

# Groq (cloud). Key stays on the server side; the browser never sees it.
GROQ_API_KEY=
# e.g. llama-3.3-70b-versatile  (verify in the Groq console)
GROQ_MODEL=

# Ollama (local). Default = Ollama running on your HOST machine (not in Docker).
# host.docker.internal is how a container reaches the host. To run Ollama as a Compose service instead,
# use the extra file:  docker compose -f docker-compose.yml -f docker-compose.ollama.yml up --build
# e.g. llama3.1:8b  (must support tool calling; `ollama pull` it first)
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- Browser-facing addresses (the BROWSER runs on your machine, not in Docker) ----------
# Baked into the frontend at build time. Change the port => rebuild: docker compose up --build frontend
VITE_API_BASE_URL=http://localhost:8002
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO
